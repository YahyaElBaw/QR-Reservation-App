NODE_ENV=development
PORT=3000
# 0.0.0.0 = reachable from phones on the LAN
HOST=0.0.0.0
MONGO_URI=mongodb+srv://UTILISATEUR:MOT_DE_PASSE@votre-cluster.mongodb.net/qrresto
JWT_SECRET=mettre-une-longue-phrase-secrete-32-caracteres-minimum
JWT_EXPIRES_IN=8h
CLOUDINARY_CLOUD_NAME=votre_cloud_name
CLOUDINARY_API_KEY=votre_api_key
CLOUDINARY_API_SECRET=votre_api_secret
CLOUDINARY_FOLDER=QrCodeApp
# Front-end origin (CORS). Never use localhost for QR codes: phones cannot reach it.
CLIENT_BASE_URL=http://localhost:5173
# Extra roles allowed on GET /dashboard/stats (comma separated, e.g. CAISSIER,CONTOIRISTE)
DASHBOARD_EXTRA_ROLES=
# true when behind a reverse proxy / PaaS (correct client IP for rate limiting)
TRUST_PROXY=false
